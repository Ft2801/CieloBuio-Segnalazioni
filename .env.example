# Database (PostgreSQL di default)
# Sostituire con la stringa di connessione del proprio server PostgreSQL
DATABASE_URL="postgresql://cielobuio:password@localhost:5432/cielobuio_segnalazioni?schema=public"

# Configurazione invio PEC (opzionale in sviluppo, obbligatoria in produzione)
# Sostituire con le credenziali della casella PEC intestata a CieloBuio
# PEC_SMTP_HOST=smtp.pec.tuodominio.it
# PEC_SMTP_PORT=465
# PEC_SMTP_USER=PEC-DA-CONFIGURARE@pec.tuodominio.it
# PEC_SMTP_PASSWORD=password_applicativa
# PEC_FROM=PEC-DA-CONFIGURARE@pec.tuodominio.it

# Soglia promemoria pratiche in attesa (giorni interi tra 1 e 36500, default 30)
REMINDER_GIORNI=30

# Giorni interi tra 1 e 36500 dopo cui la transizione automatica "inviata" -> "in_attesa" scatta (default 7)
TRANSIZIONE_INVIATA_GIORNI=7

# Anni interi tra 1 e 100 dopo cui l'anonimizzazione automatica GDPR delle segnalazioni scatta (default 10)
RETENTION_SEGNALAZIONI_ANNI=10

# Chiave di cifratura dei backup (AES-256-GCM, Base64 di 32 byte). OBBLIGATORIA:
# senza di essa backup e ripristino vengono rifiutati.
# Genera con: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=

# Livello dei log: fatal, error, warn, info, debug (default: info in produzione, debug altrove)
# LOG_LEVEL=info
# Formato leggibile per lo sviluppo locale (default: JSON)
# LOG_FORMAT=pretty

# Token statico per l'endpoint /api/metrics (compatibile con Prometheus).
# Se non impostata, /api/metrics richiede il cookie di sessione admin
# (NON compatibile con Prometheus, che non può inviare cookie HTTP-only).
# In produzione: genera con `openssl rand -hex 32` e configura Prometheus
# con `bearer_token: <METRICS_TOKEN>` nel job di scrape.
# METRICS_TOKEN=hex-encoded-32-byte-token-here

# URL pubblica della piattaforma (per i link nelle notifiche email e verifica Origin anti-CSRF)
# NEXT_PUBLIC_BASE_URL=https://segnalazioni.esempio.it
# Sottopercorso GitHub Pages (impostato automaticamente dal workflow deploy-pages.yml
# tramite steps.pages.outputs.base_path). Lasciare vuoto per Pages utente
# (<utente>.github.io), valorizzato a /<nome-repo> per Pages progetto.
# NEXT_PUBLIC_BASE_PATH=

# Modalità demo con account di prova: attiva solo nella build statica per GitHub
# Pages (impostata da next.config.pages.ts). Sul server di produzione lasciarla
# non impostata: gli account demo non vengono riconosciuti.
# NEXT_PUBLIC_CIELOBUIO_DEMO=1

# Directory per i backup generati da scripts/backup-db.ts (default ./backups)
# BACKUP_DIR=./backups

# Path assoluto dello storage degli allegati (default ./storage/uploads).
# Utile in deploy Docker dove il volume è montato altrove, o per
# condividere lo storage tra più istanze dell'app.
# STORAGE_ROOT=/app/storage/uploads

# Password dell'admin per setup non interattivo (script create-admin.ts
# in pipeline CI/CD dove lo stdin non è TTY). Solo per automazione:
# NON impostare in produzione normale, usa il prompt interattivo.
# ADMIN_PASSWORD=

