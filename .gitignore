# Dipendenze
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Il progetto usa npm come runtime ufficiale. package-lock.json è
# versionato per garantire installazione deterministica (npm ci).
yarn.lock
bun.lock

# Build output
/.next/
/out/
/build
/dist
/standalone

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
bun-debug.log*

# File di log locali
*.log
dev.log
server.log

# Variabili d'ambiente (contengono credenziali)
.env
.env*.local
.env.production
.env.development

# Database locale (file non usati in produzione PostgreSQL)
/db/*.db
/db/*.db-journal
/db/*.db-shm
/db/*.db-wal

# Backup generati dallo script scripts/backup-db.ts
/backups/

# Log generati da script cron
/logs/

# File caricati dagli utenti (allegati alle segnalazioni) - directory privata
/storage/
!/storage/.gitkeep

# Vecchia directory upload pubblica (mantenuta per retrocompatibilità, vuota)
/public/uploads/*
!/public/uploads/.gitkeep

# Cache
/.cache
/.parcel-cache
/.turbo
/.eslintcache
/.tsbuildinfo
*.tsbuildinfo

# Editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# OS
.DS_Store
Desktop.ini

# Test coverage
/coverage
*.lcov

# Prisma
/prisma/migrations/dev.db*

# File di progetto locali
.tool-versions

# File generati temporanei
/tmp
/.tmp
