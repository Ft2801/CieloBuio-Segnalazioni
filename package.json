{
  "name": "cielobuio-segnalazioni",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "author": "Fabio Tempera",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ft2801/CieloBuio-Segnalazioni.git"
  },
  "bugs": {
    "url": "https://github.com/Ft2801/CieloBuio-Segnalazioni/issues"
  },
  "homepage": "https://github.com/Ft2801/CieloBuio-Segnalazioni#readme",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "LOG_FORMAT=pretty next dev -p 3000",
    "build": "npm run typecheck && next build && tsx scripts/copy-standalone.ts .",
    "start": "node .next/standalone/server.js",
    "build:pages": "tsx scripts/build-pages.ts .",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "knip": "knip",
    "licenze": "license-checker-rseidelsohn --production --excludePrivatePackages --excludePackages \"@img/sharp-libvips-linux-x64;@img/sharp-libvips-linuxmusl-x64;caniuse-lite;elkjs\" --onlyAllow \"MIT;Apache-2.0;ISC;MIT and ISC;BSD-2-Clause;BSD-3-Clause;0BSD;Unlicense;MIT-0\" --summary",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run knip && npm run licenze && npm run test:coverage",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "db:seed": "tsx scripts/seed.ts",
    "db:create-admin": "tsx scripts/create-admin.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:restore": "tsx scripts/restore-db.ts",
    "cron:reminder": "tsx scripts/cron-entry.ts",
    "prepare": "husky",
    "test:integration": "vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "lucide-react": "^1.63.0",
    "next": "^16.4.3",
    "nodemailer": "^10.2.1",
    "otpauth": "^9.5.2",
    "pino": "^10.4.0",
    "prisma": "^7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@emnapi/core": "^1.11.2",
    "@emnapi/runtime": "^1.11.2",
    "@emnapi/wasi-threads": "^2.0.0",
    "@next/eslint-plugin-next": "^16.4.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "knip": "^5.88.1",
    "license-checker-rseidelsohn": "^5.0.1",
    "lint-staged": "^16.4.0",
    "pino-pretty": "^13.2.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "typescript7": "npm:typescript@^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "browserslist": "4.29.5",
    "fast-copy": "4.3.1",
    "baseline-browser-mapping": "2.11.34",
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "esbuild@0.28.2": true,
    "unrs-resolver": false
  },
  "lint-staged": {
    "*.{ts,tsx,mts,mjs}": [
      "prettier --write",
      "eslint --max-warnings=0"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
